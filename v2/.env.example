# ──────────────────────────────────────────────────────────────────────────────
# Scissors API v2 — environment variable template
# Copy this file to .env and fill in production values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=prod
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-replace-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/scissors

# SQLite (local development only — do NOT use in production)
# DATABASE_URL=sqlite+aiosqlite:///./scissors_v2.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme-jwt-replace-in-production
JWT_ALGORITHM=HS256

# Token lifetimes (as timedelta strings parsed by pydantic)
# Examples: "PT1H" (1 hour), "P5D" (5 days)
JWT_ACCESS_TOKEN_EXPIRES=PT120H
JWT_REFRESH_TOKEN_EXPIRES=PT272H

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local / Docker Compose
REDIS_URL=redis://localhost:6379/0

# Upstash (free tier — https://upstash.com)
# REDIS_URL=rediss://:password@host.upstash.io:6379

# Redis Cloud (free tier — https://redis.io/cloud)
# REDIS_URL=redis://:password@host.redis-cloud.com:port

# Cache TTLs in seconds
CACHE_TTL_REDIRECT=300
CACHE_TTL_SHORT=30
CACHE_TTL_LONG=60

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=1000/day;50/hour

# ── GeoIP (optional) ──────────────────────────────────────────────────────────
# Leave blank to disable — the app works fine without it
# Get a free key at https://geo.ipify.org
GEOIPIFY_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins.  Use ["*"] to allow all (not recommended for prod).
# Example: ["https://your-frontend.com","https://www.your-frontend.com"]
ALLOWED_ORIGINS=["*"]

# ── Server ────────────────────────────────────────────────────────────────────
# Number of uvicorn worker processes (set to 1 on free Render tier)
WORKERS=4
